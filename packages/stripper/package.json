{
  "name": "@mountfx/stripper",
  "version": "0.1.1",
  "description": "Framework-agnostic engine that generates Tailwind-style 11-step color scales (50-950) from brand colors, with consistent-contrast ladders (APCA Lc, WCAG 2.2) built into the generation pipeline.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "docs:lint": "deno doc --lint src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mountfx/stripper.git"
  },
  "bugs": {
    "url": "https://github.com/mountfx/stripper/issues"
  },
  "homepage": "https://github.com/mountfx/stripper#readme",
  "keywords": [
    "color",
    "colors",
    "palette",
    "color-scale",
    "design-tokens",
    "tailwind",
    "tailwindcss",
    "theming",
    "contrast",
    "accessibility",
    "a11y",
    "apca",
    "wcag",
    "oklch"
  ],
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^22.10.0",
    "apca-w3": "^0.1.9",
    "culori": "^4.0.2",
    "deno": "^2.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
