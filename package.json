{
  "name": "stripper-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter stripper-studio build",
    "studio": "pnpm --filter stripper-studio dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:coverage": "pnpm -r test:coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.73.0"
  }
}
